rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }

    // Portadas e imágenes inline del sitio público: solo get de objetos imagen.
    function isStoredImage() {
      return resource.contentType.matches('image/.*')
        && resource.size < 5 * 1024 * 1024;
    }

    match /covers/{allPaths=**} {
      allow get: if isStoredImage();
      allow list: if false;
      allow write: if isAdmin() && isImage();
    }

    match /inline/{allPaths=**} {
      allow get: if isStoredImage();
      allow list: if false;
      allow write: if isAdmin() && isImage();
    }
  }
}
